# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GLOBAL_CHECKOUT_URL: External checkout page URL for ORANOS MAHDI PRO ($9.99).
GLOBAL_CHECKOUT_URL=YOUR_GLOBAL_CHECKOUT_URL

# PAYONEER_TARGET: Your Payoneer receiving email or account ID for direct transfers.
PAYONEER_TARGET=YOUR_PAYONEER_TARGET

